    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 102,
      "title": "Shuffle I/O",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "decbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 20,
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "orientation": "horizontal",
        "showValue": "never",
        "stacking": "none",
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": 0,
        "xField": "query",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "xTickLabelSpacing": 100
      },
      "description": "Shuffle bytes for the ten queries that shuffled most, summed over the application. Each row is a SQL execution's description (sql.description), or Spark's stage name for code that runs no SQL; set a job description to name your own queries.",
      "title": "Shuffle by Query",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "topk(10, sum by (query) (label_replace(label_replace(max_over_time({__name__=~\"flare_stage_shuffle_read_bytes(_total)?\", job=~\"$service\"}[$__range]), \"query\", \"$1\", \"stage_name\", \"(.*)\"), \"query\", \"$1\", \"sql_description\", \"(.+)\")))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Read"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "B",
          "expr": "topk(10, sum by (query) (label_replace(label_replace(max_over_time({__name__=~\"flare_stage_shuffle_write_bytes(_total)?\", job=~\"$service\"}[$__range]), \"query\", \"$1\", \"stage_name\", \"(.*)\"), \"query\", \"$1\", \"sql_description\", \"(.+)\")))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Write"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Read",
              "Value #B": "Write"
            },
            "indexByName": {
              "query": 0,
              "Value #A": 1,
              "Value #B": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Read",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
