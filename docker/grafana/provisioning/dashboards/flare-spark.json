          "instant": true,
          "legendFormat": "Shuffle Write",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true
            },
            "renameByName": {
              "Value #A": "Executor Run Time p95",
              "Value #B": "Input",
              "Value #C": "Shuffle Read",
              "Value #D": "Shuffle Write",
              "sql_description": "Query",
              "stage_name": "Stage Name (Spark)"
            },
            "indexByName": {
              "stage_id": 0,
              "sql_description": 1,
              "stage_name": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6
            }
          }
        }
      ],
      "description": "Grouped by instance (per-JVM UUID) as well as stage_id, because stage ids restart per application — without it, stage 4 of one run is summed into stage 4 of another. The Query column is sql.description; Stage Name is Spark’s own value, which for async subquery and broadcast stages reads $anonfun$withThreadLocalCaptured$2."
