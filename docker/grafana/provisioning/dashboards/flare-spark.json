      "id": 100,
      "title": "Application Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Total Jobs",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum(max_over_time(traces_spanmetrics_calls_total{service=~\"$service\", span_name=~\"spark.job.*\"}[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Jobs in the time range, from Tempo's span metrics (its metrics generator). Tempo keeps a counter per span name, spark.job.0, spark.job.1 and so on, for about 15 minutes, so a rerun of the same service within that time adds to the earlier run's count."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Total Stages",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum(max_over_time({__name__=~\"flare_stage_executor_run_time(_milliseconds)?_count\", job=~\"$service\"}[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Stages completed in the time range, from Flare's flare.stage.executor.run_time histogram, which records once per stage."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Total Tasks",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum(max_over_time({__name__=~\"flare_task_duration(_milliseconds)?_count\", job=~\"$service\"}[$__range]))",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit",
          "mappings": [],
          "noValue": "0%"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Task Error Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum(max_over_time({__name__=~\"flare_task_duration(_milliseconds)?_count\", job=~\"$service\", task_result=\"FAILED\"}[$__range])) / sum(max_over_time({__name__=~\"flare_task_duration(_milliseconds)?_count\", job=~\"$service\"}[$__range])) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "title": "Task Duration Distribution",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "scheme",
            "schemeName": "Oranges"
          },
          "custom": {
            "fillOpacity": 80,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 15,
        "x": 0,
        "y": 6
      },
      "id": 10,
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "yAxis": {
          "unit": "ms"
        }
      },
      "title": "Task Duration (heatmap)",
      "description": "Task execution time distribution. Purple dots are exemplars — click to open the trace in Tempo.",
      "type": "heatmap",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum({__name__=~\"flare_task_duration(_milliseconds)?_bucket\", job=~\"$service\"}) by (le)",
          "refId": "A",
          "format": "heatmap",
          "legendFormat": "tasks",
          "exemplar": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          },
          "unit": "ms",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 9,
        "x": 15,
        "y": 6
      },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "orientation": "horizontal"
      },
      "title": "Task Duration Percentiles",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.50, sum(max_over_time({__name__=~\"flare_task_duration(_milliseconds)?_bucket\", job=~\"$service\"}[$__range])) by (le))",
          "refId": "A",
          "instant": true,
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.95, sum(max_over_time({__name__=~\"flare_task_duration(_milliseconds)?_bucket\", job=~\"$service\"}[$__range])) by (le))",
          "refId": "B",
          "instant": true,
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.99, sum(max_over_time({__name__=~\"flare_task_duration(_milliseconds)?_bucket\", job=~\"$service\"}[$__range])) by (le))",
          "refId": "C",
          "instant": true,
          "legendFormat": "p99"
        }
      ]
