      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 21,
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": 0,
        "xField": "Field",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "xTickLabelSpacing": 100
      },
      "title": "Shuffle by Executor",
      "description": "Raw shuffle bytes per executor. This is volume, not skew — see the Task Duration Skew panel for the imbalance ratio.",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum(max_over_time({__name__=~\"flare_task_shuffle_read_bytes(_total)?\", job=~\"$service\"}[$__range])) by (executor_id)",
          "refId": "A",
          "instant": true,
          "legendFormat": "Read — executor {{executor_id}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum(max_over_time({__name__=~\"flare_task_shuffle_write_bytes(_total)?\", job=~\"$service\"}[$__range])) by (executor_id)",
          "refId": "B",
          "instant": true,
          "legendFormat": "Write — executor {{executor_id}}"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "collapsed": false,
