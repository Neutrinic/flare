  <!-- ── ByteBuddy (provided by OTEL agent, not shipped) ───────────────────── -->
  <suppress>
    <notes>ByteBuddy is provided by the OTEL Java agent at runtime, not shipped in Flare JAR</notes>
    <filePath regex="true">.*byte-buddy.*\.jar.*</filePath>
